<?xml version="1.0"?>
<!-- Copyright by BeeX [2026] -->
<launch>
    <!-- Switches. Every number lives in config/*.yaml. -->
    <arg name="sim" default="false" doc="true: simulated arm instead of the serial port"/>
    <arg name="bag" default="" doc="path to a recorded bag, replayed in a loop instead of the live camera"/>
    <arg name="bag_rate" default="5.0" doc="bag replay speed; the recording is 1 Hz, the camera delivers 5 Hz"/>
    <arg name="task" default="true" doc="start the task state machine"/>
    <arg name="park" default="true" doc="start the vehicle parking search; it owns world_locked -&gt; vehicle_base"/>
    <arg name="viz" default="true" doc="start the viz node"/>
    <arg name="foxglove" default="true" doc="start foxglove_bridge"/>
    <arg name="outlier_filter" default="true" doc="drop flying pixels before building the obstacle map"/>
    <arg name="handle_carving" default="true" doc="let the jaw blades close in on the handle surface"/>
    <arg name="corridor_carving" default="true" doc="treat the approach corridor in front of each handle pose as handle"/>
    <arg name="candidate_averaging" default="true" doc="keep only candidates the collected frames agree on"/>
    <arg name="obstacle_averaging" default="false" doc="obstacle voxels must be seen in several collected frames; costs a full occupancy pass per frame and thins sparse surfaces"/>

    <arg name="config" default="$(find bringup)/config"/>

    <rosparam command="load" ns="topics" file="$(arg config)/topics.yaml"/>
    <rosparam command="load" ns="arm" file="$(arg config)/arm.yaml"/>
    <rosparam command="load" ns="jaws" file="$(arg config)/jaws.yaml"/>
    <rosparam command="load" ns="camera" file="$(arg config)/camera.yaml"/>
    <rosparam command="load" ns="vehicle" file="$(arg config)/vehicle.yaml"/>
    <rosparam command="load" ns="driver" file="$(arg config)/driver.yaml"/>
    <rosparam command="load" ns="cloud" file="$(arg config)/cloud.yaml"/>
    <rosparam command="load" ns="planner" file="$(arg config)/planner.yaml"/>
    <rosparam command="load" ns="executor" file="$(arg config)/executor.yaml"/>
    <rosparam command="load" ns="task" file="$(arg config)/task.yaml"/>
    <rosparam command="load" ns="viz" file="$(arg config)/viz.yaml"/>

    <param name="driver/simulated" type="bool" value="$(arg sim)"/>
    <param name="cloud/switches/outlier_filter" type="bool" value="$(arg outlier_filter)"/>
    <param name="cloud/switches/handle_carving" type="bool" value="$(arg handle_carving)"/>
    <param name="cloud/switches/corridor_carving" type="bool" value="$(arg corridor_carving)"/>
    <param name="cloud/switches/candidate_averaging" type="bool" value="$(arg candidate_averaging)"/>
    <param name="cloud/switches/obstacle_averaging" type="bool" value="$(arg obstacle_averaging)"/>

    <param name="robot_description"
           command="$(find xacro)/xacro $(find description)/urdf/arm.urdf.xacro arm_config:=$(arg config)/arm.yaml camera_config:=$(arg config)/camera.yaml vehicle_config:=$(arg config)/vehicle.yaml"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

    <node name="driver" pkg="driver" type="driver_node" output="screen" required="true"/>
    <node name="cloud" pkg="cloud" type="cloud_node" output="screen"/>
    <node if="$(arg park)" name="park" pkg="park" type="park_node" output="screen"/>
    <node name="planner" pkg="planner" type="planner_node" output="screen"/>
    <node name="executor" pkg="executor" type="executor_node" output="screen"/>
    <node if="$(arg task)" name="task" pkg="task" type="task_node" output="screen"/>
    <node if="$(arg viz)" name="viz" pkg="viz" type="viz_node" output="screen"/>

    <node if="$(arg foxglove)" name="foxglove" pkg="foxglove_bridge" type="foxglove_bridge" output="screen">
        <rosparam command="load" file="$(arg config)/foxglove.yaml"/>
    </node>

    <node if="$(eval arg('bag') != '')" name="bag" pkg="rosbag" type="play"
          args="--loop --quiet --rate=$(arg bag_rate) $(arg bag)"/>
</launch>
